# ============================================================
# Environment config
# Copy to .env, then change ports if they are already in use.
# ============================================================

# Ports
MYSQL_PORT=3306
MSSQL_PORT=1433
POSTGRES_PORT=5432
REDIS_PORT=6379
FLASK_PORT=5000
FRONTEND_PORT=3000

# MySQL bootstrap
MYSQL_ROOT_PASSWORD=RootPass@2025
MYSQL_DATABASE=quan_ly_chi_nhanh
MYSQL_USER=techstore

# PostgreSQL bootstrap (CN02)
POSTGRES_DB=quan_ly_chi_nhanh
POSTGRES_USER=techstore
POSTGRES_PASSWORD=MyPass@2025

# Central database used by backend
DB_ENGINE=sqlserver
DB_HOST=sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=MyPass@2025
DB_NAME=quan_ly_chi_nhanh

# Branch databases.
# Leave HOST/NAME/USER/PASSWORD empty until each branch has its own DB.
BRANCH_CN01_DB_HOST=mysql
BRANCH_CN01_DB_ENGINE=mysql
BRANCH_CN01_DB_PORT=3306
BRANCH_CN01_DB_NAME=quan_ly_chi_nhanh
BRANCH_CN01_DB_USER=techstore
BRANCH_CN01_DB_PASSWORD=MyPass@2025

BRANCH_CN02_DB_HOST=postgres
BRANCH_CN02_DB_ENGINE=postgresql
BRANCH_CN02_DB_PORT=5432
BRANCH_CN02_DB_NAME=quan_ly_chi_nhanh
BRANCH_CN02_DB_USER=techstore
BRANCH_CN02_DB_PASSWORD=MyPass@2025
