# ============================================================
# Environment config
# Docker Compose already has safe demo defaults.
# Copy this file to .env only when you need to override ports/passwords.
# ============================================================

# Ports
MYSQL_PORT=3306
MSSQL_PORT=1433
POSTGRES_PORT=5432
REDIS_PORT=6379
CENTRAL_API_PORT=5000
CN01_API_PORT=5001
CN02_API_PORT=5002
TRU_SO_SERVICE_PORT=5010
MYSQL_SERVICE_PORT=5011
POSTGRE_SERVICE_PORT=5012
CENTRAL_FRONTEND_PORT=3000
CN01_FRONTEND_PORT=3001
CN02_FRONTEND_PORT=3002
CENTRAL_FRONTEND_URL=http://localhost:3000
CN01_FRONTEND_URL=http://localhost:3001
CN02_FRONTEND_URL=http://localhost:3002
TRU_SO_SERVICE_URL=http://tru-so-service:5000
BRANCH_CN01_API_URL=http://mysql-backend:5000
BRANCH_CN02_API_URL=http://postgre-backend:5000

# MySQL bootstrap
MYSQL_ROOT_PASSWORD=RootPass@2025
MYSQL_DATABASE=quan_ly_chi_nhanh
MYSQL_USER=techstore

# PostgreSQL bootstrap (CN02)
POSTGRES_DB=quan_ly_chi_nhanh
POSTGRES_USER=techstore
POSTGRES_PASSWORD=MyPass@2025

# Central database used by backend
DB_ENGINE=sqlserver
DB_HOST=sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=MyPass@2025
DB_NAME=quan_ly_chi_nhanh

# Branch databases.
# CN01 defaults point to the MySQL service, CN02 defaults to the PostgreSQL service.
BRANCH_CN01_DB_HOST=mysql
BRANCH_CN01_DB_ENGINE=mysql
BRANCH_CN01_DB_PORT=3306
BRANCH_CN01_DB_NAME=quan_ly_chi_nhanh
BRANCH_CN01_DB_USER=techstore
BRANCH_CN01_DB_PASSWORD=MyPass@2025

BRANCH_CN02_DB_HOST=postgres
BRANCH_CN02_DB_ENGINE=postgresql
BRANCH_CN02_DB_PORT=5432
BRANCH_CN02_DB_NAME=quan_ly_chi_nhanh
BRANCH_CN02_DB_USER=techstore
BRANCH_CN02_DB_PASSWORD=MyPass@2025
