# ============================================================
#  CẤU HÌNH MÔI TRƯỜNG (chi nhánh PostgreSQL)
#  Copy thành .env → sửa PORT nếu bị trùng trên máy bạn
# ============================================================

# Ports - đổi nếu máy bạn đã dùng port này
POSTGRES_PORT=5432
REDIS_PORT=6379
FLASK_PORT=5000
FRONTEND_PORT=3000

# PostgreSQL bootstrap
POSTGRES_DB=quan_ly_chi_nhanh
POSTGRES_USER=techstore
POSTGRES_PASSWORD=MyPass@2025

# Central database used by backend
DB_HOST=postgres
DB_PORT=5432
DB_USER=techstore
DB_PASSWORD=MyPass@2025
DB_NAME=quan_ly_chi_nhanh

# Branch databases
# DB trung tâm chỉ lưu mã/tên chi nhánh. Thông tin kết nối DB chi nhánh để ở đây.
BRANCH_CN01_DB_HOST=
BRANCH_CN01_DB_ENGINE=postgresql
BRANCH_CN01_DB_PORT=5432
BRANCH_CN01_DB_NAME=
BRANCH_CN01_DB_USER=
BRANCH_CN01_DB_PASSWORD=

BRANCH_CN02_DB_HOST=
BRANCH_CN02_DB_ENGINE=postgresql
BRANCH_CN02_DB_PORT=5432
BRANCH_CN02_DB_NAME=
BRANCH_CN02_DB_USER=
BRANCH_CN02_DB_PASSWORD=
