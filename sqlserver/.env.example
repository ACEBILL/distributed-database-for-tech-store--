# ============================================================
#  CẤU HÌNH MÔI TRƯỜNG
#  Copy thành .env → sửa PORT nếu bị trùng trên máy bạn
# ============================================================

# Ports - đổi nếu máy bạn đã dùng port này
MSSQL_PORT=1433
REDIS_PORT=6379
FLASK_PORT=5000
FRONTEND_PORT=3000

# Central database used by backend
DB_HOST=sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=MyPass@2025
DB_NAME=quan_ly_chi_nhanh

# Branch databases
# DB trung tâm chỉ lưu mã/tên chi nhánh. Thông tin kết nối DB chi nhánh để ở đây.
BRANCH_CN01_DB_HOST=sqlserver
BRANCH_CN01_DB_ENGINE=sqlserver
BRANCH_CN01_DB_PORT=1433
BRANCH_CN01_DB_NAME=quan_ly_chi_nhanh
BRANCH_CN01_DB_USER=sa
BRANCH_CN01_DB_PASSWORD=MyPass@2025

BRANCH_CN02_DB_HOST=
BRANCH_CN02_DB_ENGINE=sqlserver
BRANCH_CN02_DB_PORT=1433
BRANCH_CN02_DB_NAME=
BRANCH_CN02_DB_USER=
BRANCH_CN02_DB_PASSWORD=
